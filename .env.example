# Public frontend value, embedded at BUILD time. Empty = same origin / dev proxy.
# For separate production hosting: https://api.example.com (no /socket.io path)
VITE_SOCKET_URL=

# Server RUNTIME values. Production requires NODE_ENV=production and real origins.
# Leave unset locally. Set NODE_ENV=production in the production server environment.
# NODE_ENV=production
PORT=3001
# Unset HOST defaults to 127.0.0.1 in development, 0.0.0.0 in production.
# HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Production example: ALLOWED_ORIGINS=https://play.example.com

# Vite development proxy only. Defaults to http://127.0.0.1:${PORT or 3001}.
# DEV_SOCKET_PROXY_TARGET=http://127.0.0.1:3001
