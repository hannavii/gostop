{
  "name": "gostop",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run build:server",
    "dev:server": "tsx watch server/index.ts",
    "start:server": "node dist/server/index.mjs",
    "typecheck": "tsc -b && tsc -p server/tsconfig.json",
    "build:server": "tsc -p server/tsconfig.json && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server/index.mjs",
    "test:online": "tsx --test server/tests/game.test.ts server/tests/gostop.test.ts server/tests/socket.test.ts server/tests/reconnect.test.ts && tsx --tsconfig tsconfig.app.json --test tests/online-ui.test.ts tests/reconnect-session.test.ts",
    "test:browser-reconnect": "node --import tsx tests/browser-reconnect.mjs",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "express": "^5.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2"
  }
}
